{
  "name": "fortfruit-delivery",
  "private": true,
  "version": "2.0.26",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "db:tracking": "node scripts/apply-tracking-schema.js",
    "db:expenses": "node scripts/apply-expense-schema.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "create-update": "node create-update-zip.js",
    "build-and-update": "npm run build && npm run create-update",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "android:dev": "npm run build && npx cap sync android && npx cap open android",
    "android:run": "npm run build && npx cap sync android && npx cap run android",
    "apk:debug": "npm run build && npx cap sync android && cd android && gradlew assembleDebug",
    "apk:release": "npm run build && npx cap sync android && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-updater": "^8.3.0",
    "@google/genai": "latest",
    "@supabase/supabase-js": "^2.87.3",
    "archiver": "^7.0.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "0.344.0",
    "mysql2": "^3.15.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.22.3",
    "recharts": "2.12.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
